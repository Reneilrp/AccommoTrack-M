+            'landlord_id' => $invoice->landlord_id,
+            'status_before' => $beforeStatus,
+            'status_after' => $afterStatus,
+            'summary' => $context['summary'] ?? 'Invoice status changed.',
+            'metadata' => $context['metadata'] ?? [],
+        ]);
+    }
